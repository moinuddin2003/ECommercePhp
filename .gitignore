# Database & Environment Credentials
config/database.php
.env
*.env

# Local database folder (schema.sql + any db dumps).
# NOTE: this is the only copy of the schema/seed data — back it up
# somewhere outside git before relying on this ignore rule.
database/
*.sql
*.sql.zip

# User Uploads (Ignore uploaded product/category images, but keep folders)
public/uploads/products/*
!public/uploads/products/.gitkeep
public/uploads/categories/*
!public/uploads/categories/.gitkeep

# IDE / Code Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS Generated Files
.DS_Store
Thumbs.db

# Logs & Temporary Files
*.log
tmp/